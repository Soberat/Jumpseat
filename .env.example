# Path to the SQLite database file (created on first start)
DATABASE_URL=data/jumpseat.db
# Optional: public base URL for share links, e.g. https://jumpseat.your-tailnet.ts.net
PUBLIC_ORIGIN=
# Optional: Claude API key (https://console.anthropic.com) for the AI trip planner
ANTHROPIC_API_KEY=
# Optional: RapidAPI key for AeroDataBox, to fill in flights from their number
# (free tier at https://rapidapi.com/aedbx-aedbx/api/aerodatabox)
AERODATABOX_API_KEY=

# --- Docker Compose (Tailscale sidecar) ---
# Optional auth key from https://login.tailscale.com/admin/settings/keys.
# Leave empty to log in with the link printed by `docker compose logs tailscale` instead.
TS_AUTHKEY=
# Machine name on your tailnet; the app will be at https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=jumpseat
# serve.json = tailnet only. serve-with-funnel.json = also allow public share links (/s/...)
TS_SERVE_CONFIG=serve.json
# Optional, with Funnel on: a password that lets people outside your tailnet sign in to the whole app.
# Empty = they only get share links. Your tailnet never asks for it.
APP_PASSWORD=
